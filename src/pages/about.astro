---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Your Name" description="About the photographer.">
  <article class="item">
    <header class="item-head">
      <p class="eyebrow">About</p>
      <h1>Your Name</h1>
    </header>
    <div class="prose item-body">
      <p>
        I make photographs, mostly on film, mostly on foot. This is where the work
        lives — portfolios on the left, the occasional written piece beside them.
      </p>
      <p>
        Replace this page with your own story: how you work, what you shoot, and
        how to reach you. For prints, commissions or just to say hello,
        <a href="mailto:you@example.com">get in touch</a>.
      </p>
    </div>
  </article>
</BaseLayout>
