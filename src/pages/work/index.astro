---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';

const photos = (await getCollection('photos')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Work — Your Name"
  description="The full register of frames."
>
  <section class="wrap head">
    <p class="eyebrow">The Register</p>
    <h1>Work</h1>
    <p class="count eyebrow">{photos.length} frames</p>
  </section>
  <section class="wrap">
    <Gallery photos={photos} />
  </section>
</BaseLayout>

<style>
  .head {
    padding-block: clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }
  .head h1 {
    font-size: var(--step-3);
    margin-top: 0.4rem;
  }
  .count {
    margin-top: 0.8rem;
  }
</style>
