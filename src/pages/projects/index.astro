---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
---

<BaseLayout
  title="Projects — Your Name"
  description="Written pieces and photo essays."
>
  <section class="wrap head">
    <p class="eyebrow">Field Notes</p>
    <h1>Projects</h1>
  </section>

  <section class="wrap">
    <ul class="cards">
      {
        projects.map((p) => (
          <li class="card" data-reveal>
            <a href={`/projects/${p.id}/`}>
              <div class="thumb">
                <Image
                  src={p.data.cover}
                  alt={p.data.title}
                  widths={[480, 720, 1080]}
                  sizes="(min-width: 800px) 48vw, 92vw"
                />
              </div>
              <div class="meta">
                <span class="eyebrow">
                  {dateFmt(p.data.date)}
                  {p.data.location ? ` · ${p.data.location}` : ''}
                </span>
                <h2>{p.data.title}</h2>
                <p>{p.data.summary}</p>
                <span class="read eyebrow">Read →</span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .head {
    padding-block: clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }
  .head h1 {
    font-size: var(--step-3);
    margin-top: 0.4rem;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  }
  .thumb img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--line);
  }
  .meta {
    padding-top: 1rem;
  }
  .meta h2 {
    font-size: var(--step-2);
    margin: 0.4rem 0 0.5rem;
  }
  .meta p {
    margin: 0;
    color: var(--muted);
    max-width: 50ch;
  }
  .read {
    display: inline-block;
    margin-top: 0.9rem;
    color: var(--ink);
  }
  .card a:hover .read {
    color: var(--accent);
  }
</style>
