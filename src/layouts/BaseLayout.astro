---
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = 'Your Name — Photographs',
  description = 'A minimal photography portfolio: image-led portfolios and written field notes.',
  image = '/og-default.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="shell">
      <Sidebar />
      <main id="main" class="content">
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .shell {
    display: grid;
    grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
    min-height: 100vh;
  }
  .content {
    min-width: 0;
    padding: clamp(1.5rem, 1rem + 2.5vw, 4rem) clamp(1.5rem, 1rem + 3vw, 5rem);
  }

  @media (max-width: 760px) {
    .shell {
      grid-template-columns: 1fr;
    }
  }
</style>
