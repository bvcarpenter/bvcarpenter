---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: { src: ImageMetadata; alt?: string }[];
  title?: string;
}

const { images, title = '' } = Astro.props;
---

{
  images.length > 0 && (
    <figure class="carousel" data-carousel>
      <div class="track" data-track>
        {images.map((img, i) => (
          <div class="slide">
            <Image
              src={img.src}
              alt={img.alt ?? title}
              widths={[720, 1080, 1600, 2200]}
              sizes="(min-width: 900px) 70vw, 100vw"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </div>
        ))}
      </div>

      {images.length > 1 && (
        <>
          <button class="nav prev" data-prev type="button" aria-label="Previous image">
            ‹
          </button>
          <button class="nav next" data-next type="button" aria-label="Next image">
            ›
          </button>
          <div class="dots" data-dots>
            {images.map((_, i) => (
              <button class="dot" type="button" data-dot={i} aria-label={`Go to image ${i + 1}`} />
            ))}
          </div>
        </>
      )}
    </figure>
  )
}

<style>
  .carousel {
    margin: 0;
    position: relative;
  }
  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    background: var(--sink);
    border: 1px solid var(--line);
    border-radius: 2px;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .slide :global(img) {
    width: 100%;
    height: auto;
    max-height: min(78vh, 900px);
    object-fit: contain;
    display: block;
  }

  .nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--ink);
    background: color-mix(in srgb, var(--paper) 78%, transparent);
    border: 1px solid var(--line);
    border-radius: 50%;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.18s ease, background 0.18s ease;
    backdrop-filter: blur(4px);
  }
  .carousel:hover .nav,
  .nav:focus-visible {
    opacity: 1;
  }
  .nav:hover {
    background: var(--paper);
  }
  .prev {
    left: 0.8rem;
  }
  .next {
    right: 0.8rem;
  }

  .dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--muted);
    background: transparent;
    cursor: pointer;
    transition: background 0.18s ease, border-color 0.18s ease;
  }
  .dot.active {
    background: var(--ink);
    border-color: var(--ink);
  }

  @media (hover: none) {
    .nav {
      opacity: 1;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) continue;
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];

    const index = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => {
      const max = track.children.length - 1;
      const clamped = Math.max(0, Math.min(max, i));
      track.scrollTo({ left: clamped * track.clientWidth, behavior: 'smooth' });
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => go(index() - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(index() + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));

    const sync = () => {
      const cur = index();
      dots.forEach((dot, i) => dot.classList.toggle('active', i === cur));
    };
    track.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    sync();
  }
</script>
