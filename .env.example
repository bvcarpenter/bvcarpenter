# Keystatic CMS — GitHub mode credentials.
# Copy this file to `.env` and fill in the values. `.env` is gitignored; never
# commit real secrets. In production these same four variables are set in the
# Cloudflare dashboard (Worker → Settings → Variables), not in a file.
#
# You do NOT fill these in by hand. Run `npm run dev`, open
# http://localhost:4321/keystatic, and follow the "set up Keystatic" wizard — it
# creates a GitHub App for you and prints these four values to paste here.
# See the README ("Editing content — the CMS") for the full walkthrough.

# From the GitHub App (the wizard creates the app and shows these):
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# A random string used to sign the Keystatic session cookie. Generate one with:
#   openssl rand -hex 32
KEYSTATIC_SECRET=

# The GitHub App's slug (the name in its URL, e.g. "field-register-cms").
# Must be prefixed PUBLIC_ so it is available to the browser-side admin UI.
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
