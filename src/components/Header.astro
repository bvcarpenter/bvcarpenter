---
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname;
const site = 'Your Name'; // edit in src/components/Header.astro
---

<header class="masthead wrap">
  <a href="/" class="brand" aria-label="Home">
    <span class="brand-name">{site}</span>
    <span class="brand-sub eyebrow">Photographs &amp; Field Notes</span>
  </a>
  <nav aria-label="Primary">
    {
      nav.map((item) => {
        const active = path === item.href || path.startsWith(item.href + '/');
        return (
          <a href={item.href} class:list={['nav-link', { active }]} aria-current={active ? 'page' : undefined}>
            {item.label}
          </a>
        );
      })
    }
  </nav>
</header>

<style>
  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: clamp(1.4rem, 1rem + 1.5vw, 2.4rem);
  }
  .brand {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }
  nav {
    display: flex;
    gap: 1.6rem;
  }
  .nav-link {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 0.15rem;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--ink);
    border-color: var(--accent);
  }
</style>
