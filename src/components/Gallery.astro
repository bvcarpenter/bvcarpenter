---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  photos: CollectionEntry<'photos'>[];
}
const { photos } = Astro.props;
---

<div class="gallery">
  {
    photos.map((photo, i) => (
      <figure class="frame" data-reveal style={`animation-delay:${Math.min(i, 8) * 60}ms`}>
        <Image
          src={photo.data.image}
          alt={photo.data.title}
          widths={[420, 720, 1080]}
          sizes="(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 92vw"
          loading={i < 4 ? 'eager' : 'lazy'}
        />
        <figcaption>
          <span class="t">{photo.data.title}</span>
          {photo.data.location && <span class="l">{photo.data.location}</span>}
        </figcaption>
      </figure>
    ))
  }
</div>

<style>
  .gallery {
    columns: 3 280px;
    column-gap: var(--gutter);
  }
  .frame {
    break-inside: avoid;
    margin: 0 0 var(--gutter);
  }
  .frame img {
    width: 100%;
    background: var(--line);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.8rem;
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  figcaption .t {
    color: var(--ink);
  }
  figcaption .l {
    color: var(--muted);
  }
</style>
