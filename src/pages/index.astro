---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Carousel from '../components/Carousel.astro';

const featured = (await getCollection('portfolios')).sort((a, b) => {
  const ao = a.data.order ?? Infinity;
  const bo = b.data.order ?? Infinity;
  if (ao !== bo) return ao - bo;
  return b.data.date.valueOf() - a.data.date.valueOf();
})[0];
---

<BaseLayout>
  <section class="intro">
    <h1>Photographs &amp; field notes.</h1>
    <p class="lede">
      Image-led portfolios and the occasional written piece. Pick something from
      the left — or start here.
    </p>
  </section>

  {
    featured && (
      <section class="feature">
        <a class="feature-link eyebrow" href={`/portfolios/${featured.id}`}>
          {featured.data.title} →
        </a>
        <Carousel images={featured.data.images} title={featured.data.title} />
      </section>
    )
  }
</BaseLayout>

<style>
  .intro {
    max-width: 40ch;
    margin-bottom: clamp(2rem, 1.5rem + 3vw, 4rem);
  }
  .intro h1 {
    font-size: var(--step-3);
    line-height: 1.05;
    margin: 0 0 0.8rem;
  }
  .feature-link {
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--ink);
  }
  .feature-link:hover {
    color: var(--accent);
  }
</style>
