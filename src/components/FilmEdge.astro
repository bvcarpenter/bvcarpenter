---
// FilmEdge — the signature element. Renders frame metadata the way a film lab
// prints it along the rebate edge of a negative: monospace, spaced caps, a
// single red registration dot. Only the fields you pass are shown, so a digital
// frame with no film stock simply omits it.
interface Props {
  frame?: number | string;
  camera?: string;
  lens?: string;
  film?: string;
  shutter?: string;
  aperture?: string;
  iso?: string;
}
const { frame, camera, lens, film, shutter, aperture, iso } = Astro.props;

const exposure = [shutter, aperture && `ƒ${aperture.replace(/^f\/?/i, '')}`, iso && `ISO ${iso}`]
  .filter(Boolean)
  .join('  ');

const tokens = [
  frame != null && `FRAME ${String(frame).padStart(2, '0')}`,
  camera,
  lens,
  film,
  exposure || null,
].filter(Boolean) as string[];
---

<p class="film-edge" aria-label="Capture details">
  <span class="dot" aria-hidden="true"></span>
  {
    tokens.map((t, i) => (
      <>
        {i > 0 && <span class="sep" aria-hidden="true">·</span>}
        <span>{t}</span>
      </>
    ))
  }
</p>

<style>
  .film-edge {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.55rem;
    margin: 0.7rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }
  .sep {
    color: var(--line);
  }
</style>
